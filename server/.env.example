# Salin menjadi .env lalu ganti nilainya sebelum uji coba lapangan.
SPLV_DATABASE_URL=sqlite:///./splv.db
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SPLV_JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
SPLV_ADMIN_KEY=ganti-dengan-kunci-admin-peneliti
SPLV_CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
